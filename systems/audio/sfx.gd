extends Node
## Plays short sound effects by ID from res://assets/audio/sfx/<id>.wav
## (generated by tools/generate_sfx.py). A small voice pool avoids cutting
## sounds off; slight random pitch keeps repeats from sounding mechanical.

const DIR := "res://assets/audio/sfx"
const VOICES := 10

var volume_db := -4.0
var _streams: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)


func play(id: StringName, pitch_jitter: float = 0.06, gain_db: float = 0.0) -> void:
	var stream := _stream(id)
	if stream == null:
		return
	var p := _players[_next]
	_next = (_next + 1) % VOICES
	p.stream = stream
	p.volume_db = volume_db + gain_db
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p.play()


func _stream(id: StringName) -> AudioStream:
	if _streams.has(id):
		return _streams[id]
	var path := "%s/%s.wav" % [DIR, id]
	var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
	if s == null:
		push_warning("Sfx: missing sound '%s'" % id)
	_streams[id] = s
	return s

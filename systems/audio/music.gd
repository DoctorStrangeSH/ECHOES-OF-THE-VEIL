extends Node
## Background music (R10 start): picks a piece from the situation and
## crossfades. Pieces are generated by tools/music/compose.py and share one
## leitmotif (see that file). Autoload "Music".
##
## Priority: override (epilogue) > boss fight > combat > a dialogue's own
## (companion themes, data "music") > location's own (region option "music")
## > Veil location > outdoors day/night > interior. Menu plays the title.

const DIR := "res://assets/music/"
const TRACKS: Array[String] = ["title", "day", "night", "interior", "veil", "combat", "boss", "epilogue",
	"farm", "harbour", "village", "abbey", "tunnels", "jonah", "mara", "hester"]
const FADE := 1.6
const COMBAT_HOLD := 5.0
const COMBAT_RADIUS := 240.0
const VOLUME_DB := -7.0
## Places whose own piece gives way to the night theme after dark.
const NIGHT_QUIET := ["farm", "harbour", "village"]
## Locations whose music is fixed regardless of time or indoors.
const LOCATION_MUSIC := {
	&"the_anchor": "veil", &"memory_hospital": "veil", &"memory_home": "veil", &"memory_station": "veil",
	&"keepers_rooms": "veil", &"echo_ward": "veil",
}

var override := ""
var current := ""
var _players: Array[AudioStreamPlayer] = []
var _active := 0
var _streams: Dictionary = {}
var _check := 0.0
var _combat_until := 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	if AudioServer.get_bus_index(&"Music") < 0:
		AudioServer.add_bus()
		AudioServer.set_bus_name(AudioServer.bus_count - 1, &"Music")
		AudioServer.set_bus_send(AudioServer.bus_count - 1, &"Master")
	for i in 2:
		var p := AudioStreamPlayer.new()
		p.bus = &"Music"
		p.volume_db = -80.0
		add_child(p)
		_players.append(p)


func stream_for(id: String) -> AudioStream:
	if not _streams.has(id):
		var path := DIR + id + ".ogg"
		var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
		if s is AudioStreamOggVorbis:
			(s as AudioStreamOggVorbis).loop = true
		_streams[id] = s
	return _streams[id]


func play(id: String) -> void:
	if id == current:
		return
	current = id
	var s := stream_for(id) if id != "" else null
	var old := _players[_active]
	_active = 1 - _active
	var nu := _players[_active]
	var t := create_tween().set_parallel(true)
	t.tween_property(old, "volume_db", -80.0, FADE).set_trans(Tween.TRANS_SINE)
	if s != null:
		nu.stream = s
		nu.volume_db = -40.0
		nu.play()
		t.tween_property(nu, "volume_db", VOLUME_DB, FADE).set_trans(Tween.TRANS_SINE)
	t.chain().tween_callback(func() -> void:
		if old != _players[_active]:
			old.stop())


func _exit_tree() -> void:
	for p in _players:
		p.stop()
		p.stream = null
	_streams.clear()


## What should be playing right now.
func pick() -> String:
	if override != "":
		return override
	if not GameState.is_playing:
		return "title"
	var loc := SceneFlow.current_location
	if loc == null:
		return current if current != "" else "title"
	if _boss_fight(loc):
		return "boss"
	var now := Time.get_ticks_msec() / 1000.0
	if _enemies_engaged(loc):
		_combat_until = now + COMBAT_HOLD
	if now < _combat_until:
		return "combat"
	var talk := DialogueService.current_music()
	if talk != "":
		return talk
	if LOCATION_MUSIC.has(loc.location_id):
		return LOCATION_MUSIC[loc.location_id]
	var own := String(loc.get("music")) if loc.get("music") != null else ""
	if own != "" and (own not in NIGHT_QUIET or WorldClock.get_period() not in ["night"]):
		return own
	if loc.combat_enabled:
		return "veil"
	if loc.outdoors:
		return "night" if WorldClock.get_period() in ["evening", "night"] else "day"
	return "interior"


func _process(delta: float) -> void:
	_check -= delta
	if _check > 0.0:
		return
	_check = 0.5
	play(pick())


static func _boss_fight(loc: Node) -> bool:
	for arena in loc.find_children("*", "BossArena", true, false):
		var a := arena as BossArena
		if not GameState.has_flag(a.engaged_flag):
			continue
		var boss := a.get_node_or_null(a.boss_path)
		var hp: Variant = boss.get("health") if boss != null else null
		if hp is Health and (hp as Health).health > 0:
			return true
	return false


static func _enemies_engaged(loc: Node) -> bool:
	var player := loc.get("player") as Node2D
	if player == null:
		return false
	for e in loc.get_tree().get_nodes_in_group(&"echo_enemy"):
		if not loc.is_ancestor_of(e) or not e is EchoEnemy:
			continue
		var en := e as EchoEnemy
		if en.state in [EchoEnemy.State.DRIFT, EchoEnemy.State.DEAD]:
			continue
		if en.global_position.distance_to(player.global_position) < COMBAT_RADIUS:
			return true
	return false

; Engine configuration file.
; Godot 4.7 (see docs/DECISIONS.md D-011).

config_version=5

[application]

config/name="Echoes of the Veil"
config/description="A single-player narrative RPG set in Greyford."
config/version="0.1.0-m1"
run/main_scene="res://scenes/bootstrap/game_root.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.06, 0.06, 0.09, 1)

[autoload]

EventHub="*res://systems/core/event_hub.gd"
InputConfig="*res://systems/core/input_config.gd"
Localization="*res://systems/localization/localization.gd"
GameState="*res://systems/core/game_state.gd"
WorldClock="*res://systems/time/world_clock.gd"
Journal="*res://systems/journal/journal.gd"
Inventory="*res://systems/inventory/inventory.gd"
Society="*res://systems/story/society.gd"
Livelihood="*res://systems/life/livelihood.gd"
Party="*res://systems/party/party.gd"
Expedition="*res://systems/expedition/expedition.gd"
Sfx="*res://systems/audio/sfx.gd"
SaveService="*res://systems/save/save_service.gd"
SceneFlow="*res://systems/scene_flow/scene_flow.gd"
DialogueService="*res://systems/dialogue/dialogue_service.gd"
Campaign="*res://systems/story/campaign.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="interactable"
2d_physics/layer_4="npc"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.06, 0.06, 0.09, 1)

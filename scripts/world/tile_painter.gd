@tool
class_name TilePainter
extends TileMapLayer
## Paints this layer from a text layout: one character per 16 px cell, using
## brushes from res://data/tiles/palettes.json. Builds its TileSet at runtime
## (and in the editor), so the map shows up with or without the art packs.
##
## This is for quick prototype maps. For hand-painted maps, use a regular
## TileMapLayer with a TileSet generated by tools/import_limezu.py.

const PALETTES_PATH := "res://data/tiles/palettes.json"
const EMPTY_CHARS := " ."

@export var palette_id: String = "":
	set(value):
		palette_id = value
		_queue_paint()
@export_multiline var layout: String = "":
	set(value):
		layout = value
		_queue_paint()

var _paint_queued := false


func _ready() -> void:
	paint()


func _queue_paint() -> void:
	if not is_inside_tree() or _paint_queued:
		return
	_paint_queued = true
	paint.call_deferred()


func paint() -> void:
	_paint_queued = false
	clear()
	var palette := load_palette(palette_id)
	if palette.is_empty():
		push_warning("TilePainter: palette '%s' not found" % palette_id)
		return
	var built := build_tileset(palette)
	tile_set = built["tileset"]
	var brushes: Dictionary = built["brushes"]
	var rows := layout.split("\n")
	for y in rows.size():
		var row: String = rows[y]
		for x in row.length():
			var ch := row[x]
			if ch in EMPTY_CHARS:
				continue
			if not brushes.has(ch):
				push_warning("TilePainter: no brush for '%s' at %d,%d" % [ch, x, y])
				continue
			var brush: Dictionary = brushes[ch]
			var options: Array = brush["coords"]
			set_cell(Vector2i(x, y), brush["source"], options[pick_index(x, y, options.size(), brush["grid"])])


## Grid brushes repeat a w x h block; others pick a stable pseudo-random variant.
static func pick_index(x: int, y: int, count: int, grid: Vector2i) -> int:
	if grid.x > 0 and grid.y > 0 and grid.x * grid.y == count:
		return posmod(y, grid.y) * grid.x + posmod(x, grid.x)
	return pick_variant(x, y, count)


## Stable pseudo-random choice so the map looks the same on every load.
static func pick_variant(x: int, y: int, count: int) -> int:
	if count <= 1:
		return 0
	var h := (x * 73856093) ^ (y * 19349663)
	return absi(h) % count


static func load_palette(id: String) -> Dictionary:
	if not FileAccess.file_exists(PALETTES_PATH):
		return {}
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(PALETTES_PATH))
	if not data is Dictionary or not data.has(id):
		return {}
	return data[id]


## Returns {tileset: TileSet, brushes: {char: {source, coords: Array[Vector2i], grid: Vector2i}}}.
static func build_tileset(palette: Dictionary) -> Dictionary:
	var ts := TileSet.new()
	ts.tile_size = Vector2i(AssetLibrary.TILE_SIZE, AssetLibrary.TILE_SIZE)
	ts.add_physics_layer()
	ts.set_physics_layer_collision_layer(0, 1)
	ts.set_physics_layer_collision_mask(0, 0)
	var sources := {}  # texture path -> source id
	var brushes := {}
	var half := AssetLibrary.TILE_SIZE / 2.0
	var square := PackedVector2Array([Vector2(-half, -half), Vector2(half, -half), Vector2(half, half), Vector2(-half, half)])

	for ch: String in palette:
		var b: Dictionary = palette[ch]
		var solid: bool = b.get("solid", false)
		var tex := AssetLibrary.load_texture(b.get("texture", ""))
		var source_id: int
		var coords: Array[Vector2i] = []
		if tex != null:
			var key: String = b["texture"]
			if not sources.has(key):
				var atlas := TileSetAtlasSource.new()
				atlas.texture = tex
				atlas.texture_region_size = ts.tile_size
				sources[key] = ts.add_source(atlas)
			source_id = sources[key]
			var atlas_src := ts.get_source(source_id) as TileSetAtlasSource
			for c: Array in b.get("tiles", []):
				var cell := Vector2i(int(c[0]), int(c[1]))
				if not atlas_src.has_tile(cell):
					atlas_src.create_tile(cell)
				coords.append(cell)
		else:
			var color := Color.html(b.get("placeholder", "#ff00ff"))
			var atlas := TileSetAtlasSource.new()
			atlas.texture = AssetLibrary.placeholder(ts.tile_size, color)
			atlas.texture_region_size = ts.tile_size
			atlas.create_tile(Vector2i.ZERO)
			source_id = ts.add_source(atlas)
			coords.append(Vector2i.ZERO)
		if solid:
			var src := ts.get_source(source_id) as TileSetAtlasSource
			for cell in coords:
				var data := src.get_tile_data(cell, 0)
				if data.get_collision_polygons_count(0) == 0:
					data.add_collision_polygon(0)
					data.set_collision_polygon_points(0, 0, square)
		if coords.is_empty():
			continue
		var grid := Vector2i.ZERO
		var g: Variant = b.get("grid")
		if g is Array and g.size() == 2 and tex != null:
			grid = Vector2i(int(g[0]), int(g[1]))
		brushes[ch] = {"source": source_id, "coords": coords, "grid": grid}
	return {"tileset": ts, "brushes": brushes}

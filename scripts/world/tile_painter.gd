@tool
class_name TilePainter
extends TileMapLayer
## Paints this layer from a text layout: one character per 16 px cell, using
## brushes from res://data/tiles/palettes.json. Builds its TileSet at runtime
## (and in the editor), so the map shows up with or without the art packs.
##
## This is for quick prototype maps. For hand-painted maps, use a regular
## TileMapLayer with a TileSet generated by tools/import_limezu.py.

const PALETTES_PATH := "res://data/tiles/palettes.json"
const BLOB_PATH := "res://data/tiles/blob47.json"
const EMPTY_CHARS := " ."
## Neighbour bits for blob terrains (see tools/regions/blob_map.py).
const N := 1
const NE := 2
const E := 4
const SE := 8
const S := 16
const SW := 32
const W := 64
const NW := 128

@export var palette_id: String = "":
	set(value):
		palette_id = value
		_queue_paint()
@export_multiline var layout: String = "":
	set(value):
		layout = value
		_queue_paint()

var _paint_queued := false


func _ready() -> void:
	paint()


func _queue_paint() -> void:
	if not is_inside_tree() or _paint_queued:
		return
	_paint_queued = true
	paint.call_deferred()


func paint() -> void:
	_paint_queued = false
	clear()
	var palette := load_palette(palette_id)
	if palette.is_empty():
		push_warning("TilePainter: palette '%s' not found" % palette_id)
		return
	var built := build_tileset(palette)
	tile_set = built["tileset"]
	var brushes: Dictionary = built["brushes"]
	var rows := layout.split("\n")
	var blob_layer := _overlay("BlobLayer", tile_set)
	var decor_layer := _overlay("DecorLayer", tile_set)
	for y in rows.size():
		var row: String = rows[y]
		for x in row.length():
			var ch := row[x]
			if ch in EMPTY_CHARS:
				continue
			if not brushes.has(ch):
				push_warning("TilePainter: no brush for '%s' at %d,%d" % [ch, x, y])
				continue
			var brush: Dictionary = brushes[ch]
			if brush.has("blob"):
				_paint_blob(rows, x, y, ch, brush, brushes, blob_layer, decor_layer)
				continue
			_paint_plain(Vector2i(x, y), brush)


func _paint_plain(cell: Vector2i, brush: Dictionary) -> void:
	var options: Array = brush["coords"]
	set_cell(cell, brush["source"], options[pick_index(cell.x, cell.y, options.size(), brush["grid"])])


## A blob terrain cell: the right edge/corner tile from the 47-tile set on the
## overlay layer, the neighbouring ground underneath, and now and then a bit
## of decor on the plain middle tiles, the way LimeZu's own scenes are dressed.
func _paint_blob(rows: PackedStringArray, x: int, y: int, ch: String, brush: Dictionary, brushes: Dictionary, blob_layer: TileMapLayer, decor_layer: TileMapLayer) -> void:
	var joins: String = brush["joins"]
	var mask := blob_mask(rows, x, y, joins)
	var tiles: Dictionary = brush["blob"]
	var cell := Vector2i(x, y)
	blob_layer.set_cell(cell, brush["source"], tiles.get(mask, tiles[255]))
	if mask != 255 or not brush["opaque"]:
		var under := _under_char(rows, x, y, joins, brush)
		if under != "" and brushes.has(under) and not brushes[under].has("blob"):
			_paint_plain(cell, brushes[under])
	var decor: Dictionary = brush["decor"]
	if mask == 255 and not decor.is_empty():
		var h := absi((x * 92837111) ^ (y * 689287499) ^ 0x5bd1e995) % 1000
		if h < int(decor["density"] * 1000.0):
			var opts: Array = decor["coords"]
			decor_layer.set_cell(cell, decor["source"], opts[pick_variant(y, x, opts.size())])


## Which neighbours continue the same terrain. Off-map counts as continuing,
## so terrain running into the map edge has no border drawn there.
static func blob_mask(rows: PackedStringArray, x: int, y: int, joins: String) -> int:
	var same := func(dx: int, dy: int) -> bool:
		var yy := y + dy
		var xx := x + dx
		if yy < 0 or yy >= rows.size() or xx < 0 or xx >= rows[yy].length():
			return true
		return rows[yy][xx] in joins
	var n: bool = same.call(0, -1)
	var e: bool = same.call(1, 0)
	var s: bool = same.call(0, 1)
	var w: bool = same.call(-1, 0)
	var m := 0
	if n: m |= N
	if e: m |= E
	if s: m |= S
	if w: m |= W
	if n and e and same.call(1, -1): m |= NE
	if s and e and same.call(1, 1): m |= SE
	if s and w and same.call(-1, 1): m |= SW
	if n and w and same.call(-1, -1): m |= NW
	return m


static func _under_char(rows: PackedStringArray, x: int, y: int, joins: String, brush: Dictionary) -> String:
	for d: Vector2i in [Vector2i(0, -1), Vector2i(1, 0), Vector2i(0, 1), Vector2i(-1, 0), Vector2i(1, -1), Vector2i(1, 1), Vector2i(-1, 1), Vector2i(-1, -1)]:
		var yy := y + d.y
		var xx := x + d.x
		if yy < 0 or yy >= rows.size() or xx < 0 or xx >= rows[yy].length():
			continue
		var c := rows[yy][xx]
		if not c in joins and not c in EMPTY_CHARS:
			return c
	return String(brush["under"])


## Overlay layers are internal children: rebuilt on every paint, never saved.
func _overlay(layer_name: String, ts: TileSet) -> TileMapLayer:
	for c in get_children(true):
		if c.name == layer_name:
			c.free()
	var l := TileMapLayer.new()
	l.name = layer_name
	l.tile_set = ts
	add_child(l, false, Node.INTERNAL_MODE_BACK)
	return l


## Grid brushes repeat a w x h block; others pick a stable pseudo-random variant.
static func pick_index(x: int, y: int, count: int, grid: Vector2i) -> int:
	if grid.x > 0 and grid.y > 0 and grid.x * grid.y == count:
		return posmod(y, grid.y) * grid.x + posmod(x, grid.x)
	return pick_variant(x, y, count)


## Stable pseudo-random choice so the map looks the same on every load.
static func pick_variant(x: int, y: int, count: int) -> int:
	if count <= 1:
		return 0
	var h := (x * 73856093) ^ (y * 19349663)
	return absi(h) % count


static func load_palette(id: String) -> Dictionary:
	if not FileAccess.file_exists(PALETTES_PATH):
		return {}
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(PALETTES_PATH))
	if not data is Dictionary or not data.has(id):
		return {}
	return data[id]


## Returns {tileset: TileSet, brushes: {char: {source, coords: Array[Vector2i], grid: Vector2i}}}.
static func build_tileset(palette: Dictionary) -> Dictionary:
	var ts := TileSet.new()
	ts.tile_size = Vector2i(AssetLibrary.TILE_SIZE, AssetLibrary.TILE_SIZE)
	ts.add_physics_layer()
	ts.set_physics_layer_collision_layer(0, 1)
	ts.set_physics_layer_collision_mask(0, 0)
	var sources := {}  # texture path -> source id
	var brushes := {}
	var half := AssetLibrary.TILE_SIZE / 2.0
	var square := PackedVector2Array([Vector2(-half, -half), Vector2(half, -half), Vector2(half, half), Vector2(-half, half)])

	for ch: String in palette:
		var b: Dictionary = palette[ch]
		if b.has("blob"):
			var built_blob := _blob_brush(ts, sources, ch, b)
			if not built_blob.is_empty():
				brushes[ch] = built_blob
				continue
			b = {"texture": "", "placeholder": b.get("placeholder", "#ff00ff")}
		var solid: bool = b.get("solid", false)
		var tex := AssetLibrary.load_texture(b.get("texture", ""))
		var source_id: int
		var coords: Array[Vector2i] = []
		if tex != null:
			var key: String = b["texture"]
			if not sources.has(key):
				var atlas := TileSetAtlasSource.new()
				atlas.texture = tex
				atlas.texture_region_size = ts.tile_size
				sources[key] = ts.add_source(atlas)
			source_id = sources[key]
			var atlas_src := ts.get_source(source_id) as TileSetAtlasSource
			for c: Array in b.get("tiles", []):
				var cell := Vector2i(int(c[0]), int(c[1]))
				if not atlas_src.has_tile(cell):
					atlas_src.create_tile(cell)
				coords.append(cell)
		else:
			var color := Color.html(b.get("placeholder", "#ff00ff"))
			var atlas := TileSetAtlasSource.new()
			atlas.texture = AssetLibrary.placeholder(ts.tile_size, color)
			atlas.texture_region_size = ts.tile_size
			atlas.create_tile(Vector2i.ZERO)
			source_id = ts.add_source(atlas)
			coords.append(Vector2i.ZERO)
		if solid:
			var src := ts.get_source(source_id) as TileSetAtlasSource
			for cell in coords:
				var data := src.get_tile_data(cell, 0)
				if data.get_collision_polygons_count(0) == 0:
					data.add_collision_polygon(0)
					data.set_collision_polygon_points(0, 0, square)
		if coords.is_empty():
			continue
		var grid := Vector2i.ZERO
		var g: Variant = b.get("grid")
		if g is Array and g.size() == 2 and tex != null:
			grid = Vector2i(int(g[0]), int(g[1]))
		brushes[ch] = {"source": source_id, "coords": coords, "grid": grid}
	return {"tileset": ts, "brushes": brushes}


static var _blob_def: Dictionary = {}


## {source, blob: {mask: Vector2i}, joins, under, opaque, decor} for a blob
## brush, or {} when the art pack is missing (then a flat placeholder is used).
static func _blob_brush(ts: TileSet, sources: Dictionary, ch: String, b: Dictionary) -> Dictionary:
	if _blob_def.is_empty() and FileAccess.file_exists(BLOB_PATH):
		_blob_def = JSON.parse_string(FileAccess.get_file_as_string(BLOB_PATH))
	if _blob_def.is_empty():
		return {}
	var sheet: String = _blob_def["sheet"]
	var tex := AssetLibrary.load_texture(sheet)
	if tex == null:
		return {}
	var atlas := _atlas(ts, sources, sheet, tex)
	var block := int(b["blob"])
	var tiles := {}
	for k: String in _blob_def["tiles"]:
		var c: Array = _blob_def["tiles"][k]
		var cell := Vector2i(int(c[0]), block * 4 + int(c[1]))
		if not atlas["src"].has_tile(cell):
			atlas["src"].create_tile(cell)
		tiles[int(k)] = cell
	var decor := {}
	var d: Variant = b.get("decor")
	if d is Dictionary:
		var dtex := AssetLibrary.load_texture(d["texture"])
		if dtex != null:
			var da := _atlas(ts, sources, d["texture"], dtex)
			var coords: Array[Vector2i] = []
			for c: Array in d["tiles"]:
				var cell := Vector2i(int(c[0]), int(c[1]))
				if not da["src"].has_tile(cell):
					da["src"].create_tile(cell)
				coords.append(cell)
			decor = {"source": da["id"], "coords": coords, "density": float(d.get("density", 0.1))}
	return {"source": atlas["id"], "blob": tiles, "joins": ch + String(b.get("joins", "")),
		"under": String(b.get("under", "")), "opaque": bool(b.get("opaque", false)), "decor": decor}


static func _atlas(ts: TileSet, sources: Dictionary, key: String, tex: Texture2D) -> Dictionary:
	if not sources.has(key):
		var a := TileSetAtlasSource.new()
		a.texture = tex
		a.texture_region_size = ts.tile_size
		sources[key] = ts.add_source(a)
	return {"id": sources[key], "src": ts.get_source(sources[key]) as TileSetAtlasSource}
